---
# Upstream pins. Their YAML is owned by those repositories.
ignore: |
  .github/scaffold/
  docs/guardrails/

extends: default
rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 120
  truthy:
    check-keys: false
  document-start: disable
